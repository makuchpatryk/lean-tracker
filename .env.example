# Copy to `.env` (git-ignored). One file for both ways to run the API.
# compose.yaml (`make up`, api service) reads SUPABASE_JWKS_URL. PORT and DATABASE_URL are for running the API on the host.

PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres?sslmode=disable

# Public JWKS URL of the Supabase project. Left empty, compose uses the local stack (make up): http://auth-gateway/auth/v1/.well-known/jwks.json.
# API on the host with the local stack: http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
# Hosted project: https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
